# Copy this to .env.local for local dev (gitignored).
# Base URL of the dashboard API, including /api/v1.

# Local dev (dashboard-backend running on localhost:8000):
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Production (Vercel env var), via the VPS nginx proxy:
# NEXT_PUBLIC_API_URL=https://<your-vps-domain>/api/dashboard/v1
