# --- Settings and secrets for the news channel ---
#
# HOW TO USE THIS FILE
#   Copy it to ".env" in this same folder, then fill in the values:
#       cp .env.example .env
#       nano .env
#
#   ".env" is ignored by git, so your keys never get committed anywhere.
#   This file (".env.example") is the template and holds no real secrets.
#
#   Anything you leave out falls back to the default shown in config.py, so a
#   minimal .env with just the keys below is enough to run.


# =============================================================================
# REQUIRED — the channel will not start without these
# =============================================================================

# The bot you already added to your channel.
# Get it from @BotFather in Telegram: /mybots → your bot → API Token.
TELEGRAM_BOT_TOKEN=

# Where to post. Two forms work:
#   @yourchannelname     for a PUBLIC channel
#   -1001234567890       for a private one (the numeric id)
#
# To find the numeric id: post any message in the channel, forward it to
# @userinfobot, and it will tell you. The bot must be an ADMIN of the channel
# with permission to post messages.
CHANNEL_ID=

# Where error alerts go — your own Telegram DM, not a channel. Uses the same bot
# token above. To find your id, message @userinfobot.
ERROR_CHAT_ID=

# Your OpenRouter key, from openrouter.ai/keys. Pays for all three AI steps AND
# the duplicate-meaning check, so this one key covers everything.
OPENROUTER_API_KEY=


# =============================================================================
# OPTIONAL — sensible defaults are built in, change only if you want to
# =============================================================================

# --- How fast the channel posts ---
# MAX_POSTS_PER_HOUR is the one to turn down if the channel feels too busy.
# Start low (4) while you are still tuning the writing style, then raise it.
#MAX_POSTS_PER_HOUR=12
#MAX_POSTS_PER_DAY=60
#MIN_SECONDS_BETWEEN_POSTS=90
#PUBLISH_TICK_SECONDS=120
#MAX_POSTS_PER_TICK=2

# --- How often we check the feeds, in minutes ---
#POLL_MINUTES=10

# --- Reading tweets from the shared relay ---
# Leave these alone unless you know why you are changing them. In particular the
# group name must stay different from the trading bot's ("sniper-ingest").
#REDIS_URL=redis://localhost:6379/0
#TWEET_STREAM_KEY=tweets:stream
#TWEET_STREAM_GROUP=news-channel

# Tweets older than this are ignored. This is the guard that stops a restart
# dumping an hour of old tweets into the channel at once.
#X_MAX_AGE_MINUTES=45
#X_MAX_BURST=25

# --- Throwing away stale news ---
# An item waiting longer than this is dropped unposted. A four-hour-old
# "breaking" story is worse than no story.
#QUEUE_TTL_MINUTES=90
#MAX_QUEUE_SIZE=200

# --- Duplicate detection ---
# Five checks, cheapest first. See nodes/dedup.py for the full reasoning.
#
# FUZZY_THRESHOLD:  how alike two headlines must be (0-100) to count as the same.
#                   Lower = more aggressive merging.
# COSINE_SHORTLIST: how alike two stories must LOOK to be considered a repeat
#                   (0.0-1.0). This decides nothing on its own any more — it
#                   only picks which pairs the judge reads. Lower it if real
#                   duplicates are slipping past unexamined.
# COSINE_CERTAIN:   above this, merge without paying for a judgement. Only
#                   catches near-verbatim reposts; rarely fires.
# DUPLICATE_MAX_GAP_HOURS: two items further apart than this are never compared
#                   at all. The cheapest accuracy setting here — it is what stops
#                   yesterday's daily report absorbing today's.
# DEDUP_TOP_K:      how many shortlisted candidates get read. Was effectively 1,
#                   which meant a rejected front-runner ended the search.
#FUZZY_THRESHOLD=92
#FUZZY_WINDOW_HOURS=24
#COSINE_SHORTLIST=0.72
#COSINE_CERTAIN=0.95
#COSINE_WINDOW_HOURS=48
#DUPLICATE_MAX_GAP_HOURS=12
#DEDUP_TOP_K=3

# The judge (check 5) — decides "same event or not" by actually reading both.
# Prefer a model that errs towards publishing, and TEST ORDER STABILITY before
# switching: ask it about (A,B) and (B,A) and check the answers match.
#JUDGE_MODEL=deepseek/deepseek-v3.2
#JUDGE_TIMEOUT_SECONDS=40

# --- Which AI models to use (see openrouter.ai/models for names and prices) ---
#TRIAGE_MODEL=google/gemini-2.5-flash-lite
#WRITER_MODEL=google/gemini-2.5-flash
#EDITOR_MODEL=openai/gpt-5-mini
#EMBEDDING_MODEL=openai/text-embedding-3-small

# If the editor starts rejecting more than this share of recent posts, you get a
# Telegram warning — that usually means the editor is broken, not the posts.
#EDITOR_DECLINE_ALERT_RATE=0.5

# --- Logging ---
# Set to DEBUG when hunting a problem. INFO is right for normal running.
#LOG_LEVEL=INFO
